DJANGO_SECRET_KEY=change-this-to-a-long-random-secret
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.onrender.com,your-domain.com
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://your-frontend.com,http://localhost:3000
CSRF_TRUSTED_ORIGINS=https://your-domain.com
TIME_ZONE=Asia/Karachi
TESSERACT_CMD=/usr/bin/tesseract
FRAUD_THRESHOLD=0.40
MAX_OCR_UPLOAD_MB=5
